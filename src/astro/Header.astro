---
import mark from "../../assets/mark.svg?raw";
import { SITES } from "./sites";

export interface Props { site: "schema" | "data"; siteName: string }
const { site, siteName } = Astro.props;
const home = site === "schema" ? SITES.schema : SITES.data;
---
<header class="rb-header">
  <div class="rb-header__inner">
    <a class="rb-brand" href={home}>
      <span class="rb-mark" set:html={mark} />
      <span><strong>Roastbook</strong> <span class="rb-site">{siteName}</span></span>
    </a>
    <nav aria-label="Open Coffee">
      <a href={SITES.schema} aria-current={site === "schema" ? "page" : undefined}>Schema</a>
      <a href={SITES.data} aria-current={site === "data" ? "page" : undefined}>Data</a>
      <a href={site === "schema" ? SITES.schemaRepo : SITES.dataRepo}>GitHub</a>
      <button type="button" class="rb-theme" data-theme-toggle aria-label="Switch between light and dark theme">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>
<script>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("rb-theme", next);
  });
</script>
<style>
  .rb-header { border-bottom: 1px solid var(--border); background: var(--background); }
  .rb-header__inner { max-width: var(--max-width); margin: 0 auto; padding: 0.5rem var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .rb-brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--foreground); text-decoration: none; font-family: var(--font-display); font-size: 1.0625rem; min-height: 44px; }
  .rb-mark :global(svg) { width: 2rem; height: auto; display: block; }
  .rb-site { color: var(--muted-foreground); font-weight: 600; }
  nav { display: flex; align-items: center; gap: 0.25rem; flex-wrap: wrap; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.75rem; border-radius: 0.75rem; color: var(--foreground); text-decoration: none; font-weight: 600; }
  nav a:hover { background: var(--secondary); }
  nav a[aria-current="page"] { color: var(--primary); }
  .rb-theme { min-width: 44px; padding: 0; justify-content: center; border-color: var(--border); }
</style>
