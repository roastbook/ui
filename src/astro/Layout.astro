---
import "./tokens.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

export interface Props {
  title: string;
  description?: string;
  /** Which site renders the page; marks the current entry in the header. */
  site: "schema" | "data";
  /** Shown in the footer: dataset version (data site) or schema version (schema site). */
  version?: string;
  buildDate?: string;
  canonical?: string;
}
const { title, description, site, version, buildDate, canonical } = Astro.props;
const siteName = site === "schema" ? "Open Coffee Schema" : "Open Coffee Data";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteName} · Roastbook</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6eddf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#241b17" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("rb-theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header site={site} siteName={siteName} />
    <main id="main"><slot /></main>
    <Footer site={site} version={version} buildDate={buildDate} />
  </body>
</html>
