---
import { SITES } from "./sites";

export interface Props { site: "schema" | "data"; version?: string; buildDate?: string }
const { site, version, buildDate } = Astro.props;
---
<footer class="rb-footer">
  <div class="rb-footer__inner">
    <p>
      <strong>Roastbook Open Coffee</strong>.{" "}
      {site === "data"
        ? <>Data licensed <a href="https://opensource.org/license/mit">MIT</a>. Images keep their own licence, credited on each place. No Google Maps or OpenStreetMap data.</>
        : <>Licensed <a href="https://opensource.org/license/mit">MIT</a>.</>}
    </p>
    <p class="muted tabular">
      {version && <>{site === "data" ? "Dataset" : "Schema"} {version} · </>}
      {buildDate && <>Built {buildDate} · </>}
      <a href={SITES.schemaRepo}>open-coffee-schema</a> · <a href={SITES.dataRepo}>open-coffee-data</a> · <a href={SITES.roastbook}>roastbook.coffee</a>
    </p>
  </div>
</footer>
<style>
  .rb-footer { border-top: 1px solid var(--border); font-size: 0.875rem; }
  .rb-footer__inner { max-width: var(--max-width); margin: 0 auto; padding: 1.25rem var(--gutter) 2rem; }
  .rb-footer p { margin: 0.25rem 0; }
</style>
