{
  "name": "@roastbook/ui",
  "version": "0.1.0",
  "description": "Shared shadcn UI components and theme for Roastbook apps and websites.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/roastbook/ui.git"
  },
  "exports": {
    "./*": "./src/components/*.tsx",
    "./utils": "./src/lib/utils.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./tailwind.css": "./src/styles/tailwind.css",
    "./astro/Layout.astro": "./src/astro/Layout.astro",
    "./astro/tokens.css": "./src/astro/tokens.css",
    "./sites": "./src/astro/sites.ts",
    "./assets/*": "./assets/*",
    "./foundation.css": "./src/styles/foundation.css"
  },
  "files": [
    "src",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run check:astro",
    "check:astro": "astro check",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.0.0",
    "input-otp": "^1.5.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/hanken-grotesk": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "astro": "^7.4.0",
    "@astrojs/check": "^0.9.12"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
