---
import '../styles/site.css'
import Showcase from '../components/showcase'
import mark from '../../../assets/mark.svg?raw'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore Roastbook's shared components, themes and coffee journal design." />
    <title>Roastbook UI</title>
    <link rel="canonical" href={Astro.site} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&amp;family=Hanken+Grotesk:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('roastbook-ui-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.style.colorScheme = theme;
      } catch { /* System defaults remain usable without storage. */ }
    </script>
  </head>
  <body>
    <a href="#main" class="fixed left-4 top-4 z-50 rounded-full bg-card px-5 py-3 text-foreground shadow-control not-focus:sr-only">Skip to content</a>
    <header class="border-b bg-card/80">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-5 md:px-8">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 font-display text-xl font-extrabold">
          <span class="block w-9 [&_svg]:w-full" set:html={mark} />Roastbook UI
        </a>
        <nav aria-label="Main" class="flex flex-wrap gap-5 text-sm font-semibold text-link">
          <a href="#foundations">Foundations</a><a href="#components">Components</a><a href="#example">Example</a>
          <a href="https://github.com/Roastbook/ui">GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12">
      <Showcase client:load />
    </main>
    <footer class="mx-auto max-w-7xl px-4 pb-8 text-sm text-muted-foreground md:px-8">
      Derived from the Roastbook app. Shared by its journal, website and Open Coffee explorers.
    </footer>
  </body>
</html>
